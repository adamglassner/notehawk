<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette (Hawkline, NoteHawk violet). Every key here must also exist in Dark.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#F4F3F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EFEDF6" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E3E0EC" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E8E5F0" />
    <SolidColorBrush x:Key="Brush.Track" Color="#ECEAF2" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1A1730" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5E5A73" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#10000000" />
    <SolidColorBrush x:Key="Brush.Paper" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.PaperRule" Color="#F0EEF6" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#1A1730" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#BDB8D3" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#24203D" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#2D2849" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#24203D" />

    <SolidColorBrush x:Key="Brush.Hero" Color="#1A1730" />
    <SolidColorBrush x:Key="Brush.HeroText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeroMuted" Color="#BDB8D3" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#5B3FD9" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#ECE8FC" />
    <SolidColorBrush x:Key="Brush.Highlight" Color="#B7A6FF" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#F2A93B" />
    <SolidColorBrush x:Key="Brush.Marker" Color="#FFF1B8" />
    <SolidColorBrush x:Key="Brush.BarMuted" Color="#CFCADF" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#B86A12" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C2410C" />
    <SolidColorBrush x:Key="Brush.Positive" Color="#1F7A55" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#1A1730" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#FFFFFF" />
</ResourceDictionary>
