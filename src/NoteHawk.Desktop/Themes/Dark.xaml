<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (Hawkline, NoteHawk violet). Every key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#110F1C" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1A1828" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#232033" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2D2A40" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#2A2739" />
    <SolidColorBrush x:Key="Brush.Track" Color="#2A2739" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E9E7F2" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A29DB8" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Paper" Color="#1D1B2C" />
    <SolidColorBrush x:Key="Brush.PaperRule" Color="#252236" />

    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0B0A13" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="#ADA8C4" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#17151F" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#211E2E" />
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#16141F" />

    <SolidColorBrush x:Key="Brush.Hero" Color="#4A33B8" />
    <SolidColorBrush x:Key="Brush.HeroText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.HeroMuted" Color="#D6CFFA" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#9C85FF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#120F22" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2A2450" />
    <SolidColorBrush x:Key="Brush.Highlight" Color="#C4B6FF" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#F5B95A" />
    <SolidColorBrush x:Key="Brush.Marker" Color="#5A4A1C" />
    <SolidColorBrush x:Key="Brush.BarMuted" Color="#3D3954" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#E9A24A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F07A4E" />
    <SolidColorBrush x:Key="Brush.Positive" Color="#6FD3A0" />

    <SolidColorBrush x:Key="Brush.ToastBg" Color="#E9E7F2" />
    <SolidColorBrush x:Key="Brush.ToastText" Color="#110F1C" />
</ResourceDictionary>
